# Site and model settings, sourced by every script. Edit here, not in the scripts.
# Secrets (API keys) go in ladder/secrets.env, which git ignores.

# Big files (venv, model weights, checkpoints) live under your PSC project
# space. Bridges-2 sets $PROJECT; set LADDER_ROOT yourself anywhere else.
LADDER_ROOT="${LADDER_ROOT:-${PROJECT:?set LADDER_ROOT or run on Bridges-2 where \$PROJECT is defined}/whale-ladder-work}"
WHALE_DIR="$LADDER_ROOT/WHALE"
VENV="$LADDER_ROOT/venv"
OUT_ROOT="$LADDER_ROOT/runs"
export HF_HOME="$LADDER_ROOT/hf"

# WHALE commit the patch in patches/ was written against.
WHALE_REPO="https://github.com/krafton-ai/WHALE.git"
WHALE_COMMIT="63faf4deb2dd2938775af6e2b020a9030f3aa697"

# Task model (the solver). WHALE's chess domain uses Qwen3.5-4B, which is what
# makes the "self" rung possible. Revisions are pinned to exact Hugging Face
# commits so every person running an arm uses identical weights.
SOLVER_MODEL="Qwen/Qwen3.5-4B"
SOLVER_MODEL_REVISION="851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"
SOLVER_SERVED_NAME="Qwen/Qwen3.5-4B"

# Medium rung.
QWEN27B_MODEL="Qwen/Qwen3.8-27B"
QWEN27B_REVISION="1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0"

# Chess puzzles. The install script builds them from the Lichess dataset, which
# changes over time, so when arms run on different accounts ONE person prepares
# the data and the others copy those exact files:
#   CHESS_DATA_FROM      a directory holding the three .parquet files to copy
#                        instead of preparing them (empty = prepare here)
#   CHESS_DATA_FINGERPRINT  the fingerprint the first person's install printed;
#                        when set, preflight refuses to run on different data
CHESS_DATA_FROM=""
CHESS_DATA_FINGERPRINT=""

# Strong rung. "fireworks" uses the course Fireworks credits; "deepseek" uses a
# DeepSeek platform key. FIREWORKS_DEEPSEEK_MODEL is the model id exactly as
# fireworks.ai/models lists it; check it before the first run.
DEEPSEEK_PROVIDER="fireworks"
FIREWORKS_DEEPSEEK_MODEL=""
DEEPSEEK_MODEL="deepseek-flash"

# USD per million tokens for the strong rung, used by the hard dollar cap.
# Fill these from the provider's price page for the model id above; the cap
# refuses to run the API rung while they are 0.
DEEPSEEK_PRICE_IN_PER_M="0"
DEEPSEEK_PRICE_CACHED_IN_PER_M="0"
DEEPSEEK_PRICE_OUT_PER_M="0"

# Hard stop for proposer spending in one run (one arm, one seed).
LADDER_MAX_USD="25"

# vLLM parsers for the locally served Qwen proposers. Check the vLLM recipe
# for Qwen3.5 / Qwen3.8 if the proposer check fails on tool calls.
TOOL_CALL_PARSER="qwen3_coder"
REASONING_PARSER="qwen3"
PROPOSER_MAX_MODEL_LEN="131072"
SOLVER_MAX_MODEL_LEN="32768"
