# One-cycle smoke test: one short weight phase, then one harness-search
# iteration, on 4 H100s. Its job is to prove the plumbing works and to measure
# real per-step and per-candidate costs, not to produce results.
#
# The harness phase keeps WHALE's real sizes (256 scoring puzzles, 3 proposals)
# because those are the costs we need to extrapolate; only the weight phase
# and the number of cycles are shrunk.

# Weight phase: 2 RSFT steps of 64 puzzles x 8 attempts = 1,024 rollouts.
TRAIN_BATCH_SIZE=64
PPO_MINI_BATCH_SIZE=64
ROLLOUT_N=8
ROUND_STEPS=2
# TOTAL_STEPS above ROUND_STEPS, so the driver goes on to the harness phase;
# MAX_ROUNDS=1 then stops it after that one harness phase.
TOTAL_STEPS=4
MAX_ROUNDS=1
TRAINER_SAVE_FREQ=2
# Evaluate on the 256 test puzzles once, after step 2, with 2 samples each, to
# time an evaluation pass too.
TRAINER_TEST_FREQ=2
TRAINER_VAL_BEFORE_TRAIN=False
VAL_ROLLOUT_N=2
TRAINER_TOTAL_EPOCHS=1

# 4 GPUs on one node: 2 train (FSDP), 2 serve rollouts (vLLM).
N_GPUS_PER_NODE=2
NNODES=1
ROLLOUT_NNODES=1
ROLLOUT_GPUS_PER_NODE=2
AGENT_NUM_WORKERS=16
REWARD_NUM_WORKERS=4

# Harness phase: one iteration (the incoming harness is scored first, as in
# WHALE), 3 candidate harnesses, the released 40-minute proposer timeout.
ROUND_MH_ITERS=1
PROPOSALS_PER_ITER=3
PROPOSER_TIMEOUT=2400

SEED=42
