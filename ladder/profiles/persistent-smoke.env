# Two complete cycles at the measured H100 batch/search sizes, then held-out
# evaluation. This validates persistence; it is not the full research schedule.
CYCLES=2
STEPS_PER_CYCLE=1
SEARCH_ITERS=1
SEED=42
LADDER_PERSISTENT_SEARCH=1
HYBRID_NUM_GPUS=2
HYBRID_TRAIN_BATCH=256
HYBRID_ROLLOUT_N=8
HYBRID_AGENT_NUM_WORKERS=8
HYBRID_GPU_MEM_UTIL=0.75
HYBRID_TIMEOUT_S=5400
PROPOSER_TIMEOUT=1200
LADDER_MH_LIMIT=256
PROPOSALS_PER_ITER=3
INSTALL_CONSTRAINTS="$LADDER_HOME/setup/constraints/psc-py311-cu130.txt"
CLAUDE_CODE_VERSION=2.1.197
INSTALL_PYTHON_VERSION=3.11.18
LADDER_GCC_MODULE="${LADDER_GCC_MODULE:-gcc/13.3.1-p20240614}"
