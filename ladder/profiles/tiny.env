# Tiny end-to-end test for a 1-hour interactive session (ladder/interactive_test.sh).
# Every stage runs once: one RSFT step, checkpoint save, a short validation,
# FSDP merge, solver + proposer serving, one proposer session writing one
# candidate, scoring, cleanup, report. Sizes are only big enough to exercise
# the code; timings from this profile do NOT extrapolate (startup dominates),
# which is what the smoke profile is for.

# Weight phase: 1 step of 16 puzzles x 4 attempts = 64 rollouts.
TRAIN_BATCH_SIZE=16
PPO_MINI_BATCH_SIZE=16
ROLLOUT_N=4
RSFT_SFT_MINI_BATCH_SIZE=8
RSFT_SFT_MICRO_PER_GPU=1
ROUND_STEPS=1
TOTAL_STEPS=2
MAX_ROUNDS=1
TRAINER_SAVE_FREQ=1
# Validate once, after the step, on a 32-puzzle slice of the test set that
# interactive_test.sh writes (VAL_FILES), with 1 sample each.
TRAINER_TEST_FREQ=1
TRAINER_VAL_BEFORE_TRAIN=False
VAL_ROLLOUT_N=1
TRAINER_TOTAL_EPOCHS=1

# Same 4-GPU layout as the real runs, so the test covers it.
N_GPUS_PER_NODE=2
NNODES=1
ROLLOUT_NNODES=1
ROLLOUT_GPUS_PER_NODE=2
AGENT_NUM_WORKERS=8
REWARD_NUM_WORKERS=2

# Harness phase: score the incoming harness and 1 candidate on 32 puzzles.
ROUND_MH_ITERS=1
PROPOSALS_PER_ITER=1
LADDER_MH_LIMIT=32
PROPOSER_TIMEOUT=900

SEED=42
