# Layers 3-4 on cerlab23's RTX 4090 (one 24 GB GPU, no Slurm): the real
# pipeline with real libraries at miniature size. The solver is Qwen3.5-0.8B,
# which fully fine-tunes in 24 GB; everything else (verl, vLLM, the search,
# Claude Code proposer, sleep/wake) is the same code the H100 runs use.
# Catches crashes and hand-off bugs; its timings and scores mean nothing.
#
#   export LADDER_ROOT=$HOME/whale-ladder-work CUDA_VISIBLE_DEVICES=0
#   bash ladder/run_cycles.sh whale_qwen4b mini4090

SOLVER_MODEL="Qwen/Qwen3.5-0.8B"
SOLVER_MODEL_REVISION="2fc06364715b967f1860aea9cf38778875588b17"
SOLVER_SERVED_NAME="Qwen/Qwen3.5-0.8B"

# 2 cycles x (1 training step, 1 search iteration x 3 proposals), then the test.
CYCLES=2
STEPS_PER_CYCLE=1
SEARCH_ITERS=1
SEED=11

# Training on the one GPU: 16 puzzles x 4 attempts per step. A 0.8B model may
# solve none of them, so an empty SFT step is allowed here (never on H100).
HYBRID_NUM_GPUS=1
HYBRID_TRAIN_BATCH=16
HYBRID_ROLLOUT_N=4
HYBRID_VAL_PUZZLES=8
HYBRID_VAL_ROLLOUT_N=1
HYBRID_EVAL_PUZZLES=32
HYBRID_EVAL_ATTEMPTS=2
HYBRID_ALLOW_ZERO_ACCEPTED=1
HYBRID_GPU_MEM_UTIL=0.45
HYBRID_AGENT_NUM_WORKERS=4
HYBRID_TIMEOUT_S=5400

# Search on the one GPU: one solver replica and the proposer side by side.
LADDER_SHARE_ONE_GPU=1
LADDER_SOLVER_REPLICAS=1
SOLVER_GPU_UTIL=0.25
SOLVER_MAX_MODEL_LEN=16384
PROPOSER_GPU_UTIL=0.55
PROPOSER_MAX_MODEL_LEN=65536
LADDER_MH_LIMIT=32
PROPOSALS_PER_ITER=3
PROPOSER_TIMEOUT=1200

LADDER_GPU_CHECK=4090
LADDER_ALLOW_NO_SLURM=1
# The 27B proposer needs about 54 GB; it is checked on the H100s (layer 5).
LADDER_SKIP_ARMS="whale_qwen27b"
