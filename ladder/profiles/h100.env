# The real runs: 2 H100s per arm (Sumanth's shared two-GPU layout).
#
#   bash ladder/run_cycles.sh <arm> h100      inside a 2-GPU allocation
#
# Schedule is WHALE's best fixed schedule, (E, I) = (0.2 epoch, 6 iterations):
# 13 training steps of 256 puzzles x 8 attempts, then 6 search iterations of 3
# proposals, per cycle. CYCLES is a budget decision for the team; at the
# measured ~26 min per training step and ~20 min per search iteration (Sumanth's
# B1, 2 H100s) one cycle is roughly 7-8 hours, so 4 cycles is ~30 hours per
# arm. run_cycles.sh resumes, so an arm can span several Slurm jobs.
CYCLES=4
STEPS_PER_CYCLE=13
SEARCH_ITERS=6
SEED=42

HYBRID_TIMEOUT_S=28800
PROPOSER_TIMEOUT=2400
LADDER_MH_LIMIT=256
PROPOSALS_PER_ITER=3
