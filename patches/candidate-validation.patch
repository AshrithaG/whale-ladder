+def _reject_row(
+    iteration: int, name: str, candidate: dict[str, Any], reason: str, status: str = "rejected_invalid"
+) -> dict[str, Any]:
+    return {
+        "iteration": iteration,
+        "harness": name,
+        "status": status,
+        "reason": reason[:300],
+        "hypothesis": candidate.get("hypothesis", "") if isinstance(candidate, dict) else "",
+        "axis": candidate.get("axis", "?") if isinstance(candidate, dict) else "?",
+    }
+
+
+def read_pending_candidates(run_dir: Path, next_names: list[str], iter_dir: Path) -> list[Any]:
+    """Candidates from pending_eval.json, recovering what a malformed or missing
+    manifest leaves behind (whale-ladder). A proposal with no manifest and no
+    harness files yields no candidates instead of an exception."""
+    pending_path = run_dir / "pending_eval.json"
+    candidates: list[Any] = []
+    if pending_path.exists():
+        shutil.copy(pending_path, iter_dir / "pending_eval.json")
+        try:
+            data = json.loads(pending_path.read_text())
+            raw = data.get("candidates", []) if isinstance(data, dict) else data
+            candidates = raw if isinstance(raw, list) else []
+        except (ValueError, OSError) as exc:
+            print(f"{_ts()} pending_eval.json unreadable ({exc}); recovering from harness files")
+        pending_path.unlink()
+    if not candidates:
+        candidates = [
+            {"name": name, "axis": "recovered",
+             "hypothesis": "Recovered from proposer-created harness.py without usable pending_eval.json."}
+            for name in next_names
+            if (run_dir / "harnesses" / name / "harness.py").exists()
+        ]
+        if not candidates:
+            print(f"{_ts()} proposer wrote no manifest and no harness files")
+    return candidates
+
+
+def validate_proposals(
+    run_dir: Path, candidates: list[Any], next_names: list[str], iteration: int
+) -> tuple[list[str], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
+    """Split one proposal into loadable candidates and recorded rejects.
+
+    whale-ladder: one rule for every proposer model. Invalid proposals are
+    skipped and recorded instead of aborting the search, so a weak proposer
+    scores low rather than crashing the run, and the invalid count is itself a
+    measured outcome. No candidate is repaired.
+    Returns (valid_names, valid_candidates, invalid_rejects, prompt_only_rejects).
+    """
+    valid_names: list[str] = []
+    valid_candidates: list[dict[str, Any]] = []
+    invalid_rejects: list[dict[str, Any]] = []
+    prompt_only_rejects: list[dict[str, Any]] = []
+    seen_names: set[str] = set()
+    for index, candidate in enumerate(candidates):
+        if not isinstance(candidate, dict):
+            invalid_rejects.append(_reject_row(iteration, f"entry{index}", {}, "manifest entry is not an object"))
+            continue
+        if "name" not in candidate:
+            # Proposers label the slot with a synonym; the chess skill never
+            # states the manifest format, so map the common ones.
+            for alias in ("slot", "harness", "id", "harness_name", "slot_name"):
+                if isinstance(candidate.get(alias), str):
+                    candidate["name"] = candidate[alias]
+                    print(f"{_ts()} pending_eval: mapped '{alias}' -> 'name' ({candidate['name']})")
+                    break
+        name = candidate.get("name")
+        if not isinstance(name, str) or name not in next_names:
+            invalid_rejects.append(
+                _reject_row(iteration, str(name), candidate, f"not one of this iteration's slots {next_names}")
+            )
+            continue
+        if name in seen_names:
+            continue
+        seen_names.add(name)
+        try:
+            validate_candidate(run_dir, name)
+        except Exception as exc:
+            if getattr(exc, "fatal_worker_setup", False):
+                raise
+            status = getattr(exc, "status", "rejected_prompt_only" if PROMPT_ONLY else "rejected_invalid")
+            print(f"{_ts()} {status} {name}: {exc}")
+            row = _reject_row(iteration, name, candidate, str(exc), status=status)
+            outcome = getattr(exc, "outcome", {})
+            if isinstance(outcome, dict):
+                for key in ("evidence", "resource", "resource_policy", "applied_policy", "usage"):
+                    if key in outcome:
+                        row[key] = outcome[key]
+            (prompt_only_rejects if status == "rejected_prompt_only" else invalid_rejects).append(row)
+            continue
+        valid_names.append(name)
+        valid_candidates.append(candidate)
+    # Every requested slot consumes its opportunity, even when the proposer
+    # emits no files or an entry with an unassigned name. Metadata errors are
+    # recorded too, but do not create extra candidate opportunities.
+    represented = set(valid_names) | {
+        row["harness"] for row in invalid_rejects + prompt_only_rejects
+        if row["harness"] in next_names
+    }
+    for name in next_names:
+        if name not in represented:
+            invalid_rejects.append(_reject_row(
+                iteration, name, {}, "No usable proposal for this requested slot", "rejected_missing"
+            ))
+    for row in invalid_rejects + prompt_only_rejects:
+        row["requested_slot"] = row["harness"] in next_names
+    return valid_names, valid_candidates, invalid_rejects, prompt_only_rejects
+
+
+def scoring_outcomes(
+    run_dir: Path, candidates: list[dict[str, Any]], results: Any, iteration: int
+) -> tuple[list[str], list[dict[str, Any]]]:
+    """Consume named containment outcomes; retain legacy sweep compatibility."""
+    evaluated: list[str] = []
+    rejected: list[dict[str, Any]] = []
+    results = results if isinstance(results, list) else []
+    for candidate in candidates:
+        name = candidate["name"]
+        named = [row for row in results if isinstance(row, dict) and row.get("harness") == name]
+        legacy = [row for row in results if isinstance(row, (tuple, list)) and len(row) == 2
+                  and isinstance(row[0], str) and len(row[0].split("/")) == 3
+                  and row[0].split("/")[1] == name]
+        if len(named) == 1 and named[0].get("status") == "evaluated":
+            evaluated.append(name)
+            continue
+        if not named and legacy and all(row[1] is True for row in legacy):
+            evaluated.append(name)
+            continue
+        outcome = named[0] if len(named) == 1 else {}
+        status = outcome.get("status", "rejected_evaluation")
+        if not isinstance(status, str) or status not in {"rejected_timeout", "rejected_evaluation", "rejected_resource_limit"}:
+            status = "rejected_evaluation"
+        row = _reject_row(iteration, name, candidate,
+                          str(outcome.get("reason", "Missing, malformed, or failed scoring outcome")), status)
+        row["requested_slot"] = True
+        for key in ("evidence", "resource", "resource_policy", "applied_policy", "usage"):
+            if key in outcome:
+                row[key] = outcome[key]
+        rejected.append(row)
+        # Even legacy evaluators may have stale/partial files. These must not
+        # enter the frontier or success-threshold selection.
+        for source in (run_dir / "logs").glob(f"*/{name}"):
+            destination = run_dir / "rejected-score-evidence" / str(time.time_ns()) / source.parent.name / name
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.move(str(source), destination)
+    return evaluated, rejected
 
 
