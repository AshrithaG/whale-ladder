--- a/domains/chess_puzzles/meta_harness/claude_wrapper.py
+++ b/domains/chess_puzzles/meta_harness/claude_wrapper.py
@@ -37,6 +37,79 @@ TOOLS_BASH = ["Read", "Glob", "Grep", "Edit", "Write", "Bash"]
 TOOLS_ALL = TOOLS_BASH + ["Agent", "WebSearch", "WebFetch"]
 
 
+class ProposerBudgetExceeded(RuntimeError):
+    """Raised before a proposer session when the run's dollar cap is spent."""
+
+
+def _price(name):
+    try:
+        return float(os.environ.get(name, "0") or 0)
+    except ValueError:
+        return 0.0
+
+
+def _ledger_spent(path):
+    """Sum of cost_usd over the JSONL ledger at path; 0 when there is none."""
+    if not path or not Path(path).exists():
+        return 0.0
+    spent = 0.0
+    for line in Path(path).read_text().splitlines():
+        try:
+            spent += float(json.loads(line).get("cost_usd", 0.0))
+        except (ValueError, AttributeError):
+            continue
+    return spent
+
+
+def _check_budget():
+    """Stop the run before a proposer call once LADDER_MAX_USD is spent.
+
+    Claude Code's own total_cost_usd assumes Anthropic prices, which is wrong
+    for any other backend, so cost is recomputed from token counts with the
+    LADDER_PRICE_* rates (USD per million tokens) of the backend in use.
+    """
+    cap = os.environ.get("LADDER_MAX_USD", "").strip()
+    if not cap:
+        return
+    spent = _ledger_spent(os.environ.get("LADDER_COST_LEDGER"))
+    if spent >= float(cap):
+        raise ProposerBudgetExceeded(
+            f"proposer budget spent: ${spent:.2f} >= LADDER_MAX_USD=${float(cap):.2f}"
+        )
+
+
+def _record_cost(result):
+    ledger = os.environ.get("LADDER_COST_LEDGER", "").strip()
+    if not ledger:
+        return
+    usage = result.token_usage or {}
+    fresh_in = usage.get("input_tokens", 0) + usage.get("cache_creation_input_tokens", 0)
+    cached_in = usage.get("cache_read_input_tokens", 0)
+    out = usage.get("output_tokens", 0)
+    cost = (
+        fresh_in * _price("LADDER_PRICE_IN_PER_M")
+        + cached_in * _price("LADDER_PRICE_CACHED_IN_PER_M")
+        + out * _price("LADDER_PRICE_OUT_PER_M")
+    ) / 1e6
+    row = {
+        "ts": datetime.now(timezone.utc).isoformat(),
+        "name": result.name,
+        "model": result.model,
+        "backend": os.environ.get("LADDER_RUNG", ""),
+        "exit_code": result.exit_code,
+        "duration_s": round(result.duration_seconds, 1),
+        "input_tokens": fresh_in,
+        "cached_input_tokens": cached_in,
+        "output_tokens": out,
+        "cost_usd": round(cost, 6),
+        "n_tool_calls": len(result.tool_calls),
+        "n_tool_errors": sum(1 for tc in result.tool_calls if tc.is_error),
+    }
+    Path(ledger).parent.mkdir(parents=True, exist_ok=True)
+    with open(ledger, "a") as fh:
+        fh.write(json.dumps(row) + "\n")
+
+
 def _slugify(text, max_words=4):
     words = re.sub(r"[^a-z0-9\s]", "", text.lower()).split()
     return "-".join(words[:max_words]) or "run"
@@ -531,6 +604,8 @@ def run(
         effort=effort,
     )
 
+    _check_budget()
+
     effective_cwd = cwd or os.getcwd()
     env = os.environ.copy()
     env.setdefault("IS_SANDBOX", "1")
@@ -625,4 +700,5 @@ def run(
     result.skill = skill_info
     result.name = name
     log_session(result, log_dir)
+    _record_cost(result)
     return result
