#!/usr/bin/env python3
"""Fake LiteLLM proxy for the CPU mock run: answers the health check and logs
which backend model its config routes to. The mock proposer (tests/mock/bin/
claude) never calls a model, so no other route is needed."""
import argparse
import json
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ap = argparse.ArgumentParser()
ap.add_argument("--config", required=True)
ap.add_argument("--host", default="127.0.0.1")
ap.add_argument("--port", type=int, required=True)
args, _ = ap.parse_known_args()
config = json.loads(open(args.config).read())
backend = config["model_list"][0]["litellm_params"]["model"]
print(f"mock litellm: routing ladder-proposer -> {backend} on port {args.port}", flush=True)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        body = b"I'm alive!"
        self.send_response(200 if self.path.startswith("/health") else 404)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


ThreadingHTTPServer((args.host, args.port), Handler).serve_forever()
