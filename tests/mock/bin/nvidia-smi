#!/usr/bin/env python3
"""Fake nvidia-smi for the CPU mock run: MOCK_NUM_GPUS idle H100s."""
import os
import sys

n = int(os.environ.get("MOCK_NUM_GPUS", "2"))
args = sys.argv[1:]
ids = list(range(n))
if "-i" in args:
    ids = [int(x) for x in args[args.index("-i") + 1].split(",") if x.strip().isdigit()]
values = {"index": None, "uuid": "GPU-mock-{i}", "name": "NVIDIA H100 80GB HBM3 (mock)",
          "memory.used": "0", "memory.total": "81559", "utilization.gpu": "0", "driver_version": "mock"}
if "-L" in args:
    for i in ids:
        print(f"GPU {i}: NVIDIA H100 80GB HBM3 (mock) (UUID: GPU-mock-{i})")
elif any(a.startswith("--query-gpu=") for a in args):
    fields = next(a for a in args if a.startswith("--query-gpu=")).split("=", 1)[1].split(",")
    for i in ids:
        print(", ".join(str(i) if f == "index" else values.get(f, "0").format(i=i) for f in fields))
elif any(a.startswith("--query-compute-apps") for a in args):
    pass
else:
    print(f"mock nvidia-smi: {n} GPU(s), all idle")
